{%- comment -%}
  Tool manifest — test_bad_annotations (TEST FIXTURE, app-owned). Registered ONLY when
  the MCP_ENABLE_TEST_TOOLS constant is set (see registry). Negative control for the
  manifest meta-schema: readOnlyHint is a string, not a boolean, so the engine must
  exclude this tool from tools/list rather than serve a wrong hint.
{%- endcomment -%}
{% liquid
  assign m = {}
  assign m['name'] = 'test_bad_annotations'
  assign m['version'] = '1.0.0'
  assign m['description'] = 'TEST FIXTURE (not a production tool): declares a malformed annotation and must never be served.'
  assign schema = {"type":"object","additionalProperties":false,"properties":{}}
  assign m['input_schema'] = schema
  assign hints = {"readOnlyHint":"yes"}
  assign m['annotations'] = hints
  assign m['mutating'] = false
  assign m['authorization_policy'] = 'public_read'
  assign m['requires_approval'] = false
  assign m['idempotent'] = true
  assign m['handler'] = 'mcp/tests/tools/test_bad_annotations/call'
  return m
%}

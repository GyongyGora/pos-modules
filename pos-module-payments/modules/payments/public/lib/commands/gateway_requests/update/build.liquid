{% doc %}
  @param {object} object - The response object to process
  @param {object} gateway_request - The gateway request to update
{% enddoc %}
{% liquid
  assign response_status = object.response.status | append: ''
  # a gateway can answer with something other than JSON (an HTML error page, an empty body)
  assign body_start = object.response.body | strip | slice: 0
  assign gateway_object_id = null
  if body_start == '{'
    assign gateway_object_id = object.response.body | parse_json | hash_dig: 'id'
  endif
  assign object = {
    "id": gateway_request.id,
    "response_body": object.response.body,
    "response_status": response_status,
    "gateway_object_id": gateway_object_id
  }

  return object
%}

<style>
  .ov-page {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: var(--pos-primitive-size-3) var(--pos-primitive-size-3) var(--pos-primitive-size-5);
    max-width: 1100px;
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }

  .ov-stage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--pos-primitive-size-2);
    width: 100%;
  }

  .ov-comp-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--pos-primitive-size-2);
    width: 100%;
    margin-top: var(--pos-gap-section-section);
  }

  .ov-comp-section {
    margin-top: var(--pos-gap-section-section);
  }

  .ov-comp-section-label {
    font-size: var(--pos-font-size-body-small);
    font-weight: 600;
    color: var(--pos-color-content-text-supplementary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 var(--pos-primitive-size-15);
  }

  .ov-comp-section .ov-comp-grid {
    margin-top: 0;
  }

  @media (max-width: 1280px) {
    .ov-comp-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 1350px) {
    .ov-stage {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .ov-comp-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .ov-stage {
      grid-template-columns: 1fr;
    }
    .ov-comp-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Hero card */
  .ov-card {
    /* Text tokens: standout variants so they theme correctly on interactive bg */
    --pos-color-content-text: var(--pos-color-standout-text);
    --pos-color-content-text-supplementary: var(--pos-color-standout-text-supplementary);

    position: relative;
    width: 100%;
    min-height: 220px;
    border-radius: var(--pos-radius-card);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 85% 8%, rgba(255, 255, 255, 0.12) 0%, transparent 52%),
      var(--pos-color-interactive);
    isolation: isolate;
    cursor: pointer;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transform: translateY(0);
    transition:
      transform 520ms cubic-bezier(.2,.8,.2,1),
      box-shadow 520ms cubic-bezier(.2,.8,.2,1);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.04) inset,
      var(--pos-primitive-shadow-medium);
    will-change: transform;
  }
  .ov-card:hover,
  .ov-card:focus-visible {
    transform: translateY(-8px);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.07) inset,
      var(--pos-primitive-shadow-blurred);
    outline: none;
  }

  .ov-card__bg  { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .ov-card__veil {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(6,9,18,0) 0%, rgba(6,9,18,0.10) 55%, rgba(6,9,18,0.20) 100%),
      linear-gradient(95deg, rgba(6,9,18,0.17) 0%, rgba(6,9,18,0.07) 45%, rgba(6,9,18,0) 75%);
  }
  .ov-card__body {
    position: relative; z-index: 2;
    flex: 1;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: var(--pos-primitive-size-3);
  }

  .ov-card__title {
    font-size: var(--pos-font-size-m);
    font-family: var(--pos-font-buttons);
    line-height: 1.08; font-weight: 700; letter-spacing: -0.02em;
    color: var(--pos-color-content-text);
    margin: 0 0 var(--pos-primitive-size-15);
  }
  .ov-card__desc {
    font-size: var(--pos-font-size-body-small);
    font-family: var(--pos-font-buttons);
    line-height: 1.5;
    color: var(--pos-color-standout-text);
    margin: 0 0 var(--pos-primitive-size-2);
    max-width: 28ch;
  }

  /* DS primary button overrides for dark card context */
  .ov-card__btn {
    align-self: flex-start;
  }
  .ov-card__btn-icon { display: inline-flex; transition: transform 220ms cubic-bezier(.2,.8,.2,1); }
  .ov-card:hover .ov-card__btn { transform: translateY(-1px); }
  .ov-card:hover .ov-card__btn-icon { transform: translateX(3px); }

  /* SVG layer: glow uses interactive-inverted via currentColor; accent shapes use it as fill */
  .ov-card__bg { color: var(--pos-color-interactive-inverted); }
  .ov-tok-accent { fill: var(--pos-color-interactive); fill-opacity: 0.65; }

  /* Glow */
  .ov-glow { transition: opacity 600ms ease, transform 900ms cubic-bezier(.2,.8,.2,1); opacity: 0.5; transform-origin: center; }
  .ov-card:hover .ov-glow { opacity: 1; transform: scale(1.08); }

  /* Card 1 — Tokens: scattered triangles */
  .ov-tok {
    transform-origin: center;
    transform-box: fill-box;
    opacity: 0.5;
    transition: transform 900ms cubic-bezier(.2,.8,.2,1), opacity 600ms ease;
  }
  .ov-card:hover .ov-tok {
    transform: translate(var(--dx, 0), var(--dy, 0)) rotate(var(--dr, 0));
    opacity: 1;
  }

  /* Card 2 — Cube: faces assemble on hover */
  .ov-face { transform-origin: 190px 230px; opacity: 0.5; transition: transform 1100ms cubic-bezier(.2,.8,.2,1), opacity 700ms ease; }
  .ov-face-top   { transform: translate(0, -90px); }
  .ov-face-left  { transform: translate(-80px, 70px); }
  .ov-face-right { transform: translate(80px, 70px); }
  .ov-card:hover .ov-face-top,
  .ov-card:hover .ov-face-left,
  .ov-card:hover .ov-face-right { transform: translate(0, 0); opacity: 1; }

  .ov-axis { transition: opacity 600ms ease 350ms, transform 900ms cubic-bezier(.2,.8,.2,1) 350ms; opacity: 0; transform-origin: 190px 230px; transform: scale(0.6); }
  .ov-card:hover .ov-axis { opacity: 1; transform: scale(1); }

  /* Card 3 — Composites: 3 cubes connect on hover */
  .ov-cube { opacity: 0.5; transition: transform 1100ms cubic-bezier(.2,.8,.2,1), opacity 700ms ease; }
  .ov-cube-a { transform: translate(0, -110px); }
  .ov-cube-b { transform: translate(-115px, 75px); }
  .ov-cube-c { transform: translate(115px, 75px); }
  .ov-card:hover .ov-cube-a { transform: translate(0, -35px); opacity: 1; }
  .ov-card:hover .ov-cube-b { transform: translate(-60.6px, 0); opacity: 1; }
  .ov-card:hover .ov-cube-c { transform: translate(60.6px, 0); opacity: 1; }


  @media (prefers-reduced-motion: reduce) {
    .ov-card, .ov-tok, .ov-face, .ov-cube, .ov-glow, .ov-card__btn, .ov-card__btn svg {
      transition: none !important; animation: none !important;
    }
    .ov-card:hover .ov-tok { transform: none; }
    .ov-face-top, .ov-face-left, .ov-face-right,
    .ov-cube-a, .ov-cube-b, .ov-cube-c { transform: none !important; }
  }
</style>

---
layout: 'modules/common-styling/style-guide'
---
<div class="styleguide-ds">

  <div class="styleguide-ds-layout">

    <aside class="styleguide-ds-sidebar">
      {% render 'modules/common-styling/style-guide/nav-left', active: '/style-guide/overview' %}
    </aside>

    <main class="styleguide-ds-main" id="main-content">
      <div class="ov-page">
        <div class="ov-stage">

          <!-- ============================================================ -->
          <!-- CARD 1 — TOKENS                                               -->
          <!-- ============================================================ -->
          <a class="ov-card" href="/style-guide/foundations/tokens" tabindex="0" aria-label="Design Tokens">
            <svg class="ov-card__bg" viewBox="-50 110 380 460" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
              <defs>
                <linearGradient id="k1-teal" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%"  stop-color="#000000" stop-opacity="0.1"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.22"/>
                </linearGradient>
                <linearGradient id="k1-blue" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%"  stop-color="#000000" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.28"/>
                </linearGradient>
                <linearGradient id="k1-violet" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%"  stop-color="#000000" stop-opacity="0.07"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.03"/>
                </linearGradient>
                <linearGradient id="k1-white-a" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.42"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.22"/>
                </linearGradient>
                <linearGradient id="k1-white-b" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%"  stop-color="#ffffff" stop-opacity="0.28"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.14"/>
                </linearGradient>
                <radialGradient id="k1-glow-a" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="currentColor" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                </radialGradient>
                <radialGradient id="k1-glow-b" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="currentColor" stop-opacity="0.18"/>
                  <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="380" height="460" fill="none"/>
              <circle class="ov-glow" cx="290" cy="100" r="170" fill="url(#k1-glow-a)"/>
              <circle class="ov-glow" cx="90" cy="370" r="170" fill="url(#k1-glow-b)"/>
              <polygon class="ov-tok" style="--dx:102px;--dy:111px;--dr:-4deg" points="50,70 110,100 50,130" fill="url(#k1-teal)"/>
              <polygon class="ov-tok" style="--dx:-87px;--dy:126px;--dr:0deg" points="270,50 336,82 270,114" fill="url(#k1-teal)"/>
              <polygon class="ov-tok" style="--dx:111px;--dy:-41px;--dr:4deg" points="40,250 100,278 40,306" fill="url(#k1-blue)"/>
              <polygon class="ov-tok" style="--dx:-93px;--dy:-49px;--dr:-4deg" points="280,260 340,288 280,316" fill="url(#k1-teal)"/>
              <polygon class="ov-tok" style="--dx:9px;--dy:145px;--dr:0deg" points="160,30 220,60 160,90" fill="url(#k1-white-b)"/>
              <polygon class="ov-tok" style="--dx:0px;--dy:-134px;--dr:4deg" points="170,360 230,388 170,416" fill="url(#k1-violet)"/>
              <polygon class="ov-tok" style="--dx:0px;--dy:34px;--dr:-4deg" points="190,150 250,210 130,210" fill="url(#k1-white-a)" opacity="0.72"/>
              <polygon class="ov-tok" style="--dx:0px;--dy:-51px;--dr:0deg" points="190,250 250,310 130,310" fill="url(#k1-teal)" opacity="0.55"/>
              <polygon class="ov-tok ov-tok-accent" style="--dx:68px;--dy:10px;--dr:4deg" points="100,200 130,218 100,236"/>
              <polygon class="ov-tok ov-tok-accent" style="--dx:-68px;--dy:2px;--dr:-4deg" points="260,210 290,228 260,246"/>
            </svg>
            <div class="ov-card__veil"></div>
            <div class="ov-card__body">
              <h3 class="ov-card__title">Design Tokens</h3>
              <p class="ov-card__desc">Colors, spacing, typography — the atomic building blocks behind every component.</p>
              <span class="pos-button pos-button-primary ov-card__btn">
                Tokens
<span class="ov-card__btn-icon">{% render 'modules/common-styling/icon', icon: 'dashRight' %}</span>
              </span>
            </div>
          </a>

          <!-- ============================================================ -->
          <!-- CARD 2 — COMPONENTS                                           -->
          <!-- ============================================================ -->
          <a class="ov-card" href="/style-guide/component-template" tabindex="0" aria-label="Components">
            <svg class="ov-card__bg" viewBox="-50 120 380 460" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
              <defs>
                <linearGradient id="k2-top" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.45"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.28"/>
                </linearGradient>
                <linearGradient id="k2-left" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.12"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.22"/>
                </linearGradient>
                <linearGradient id="k2-right" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.28"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.42"/>
                </linearGradient>
                <linearGradient id="k2-violet" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.14"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
                </linearGradient>
                <radialGradient id="k2-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="currentColor" stop-opacity="0.22"/>
                  <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="380" height="460" fill="none"/>
              <circle class="ov-glow" cx="190" cy="230" r="180" fill="url(#k2-glow)"/>
              <g class="ov-face ov-face-top">
                <polygon points="190,150 120.7,190 190,230" fill="url(#k2-top)" opacity="0.92"/>
                <polygon points="190,150 259.3,190 190,230" fill="url(#k2-top)"/>
              </g>
              <g class="ov-face ov-face-left">
                <polygon points="120.7,190 190,230 120.7,270" fill="url(#k2-left)"/>
                <polygon points="120.7,270 190,230 190,310" fill="url(#k2-left)" opacity="0.85"/>
              </g>
              <g class="ov-face ov-face-right">
                <polygon points="259.3,190 190,230 259.3,270" fill="url(#k2-right)"/>
                <polygon points="259.3,270 190,230 190,310" fill="url(#k2-right)" opacity="0.85"/>
              </g>
              <g class="ov-axis" stroke="rgba(255,255,255,0.28)" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="5 5" fill="none">
                <line x1="190" y1="150" x2="190" y2="80"/>
                <line x1="120.7" y1="270" x2="60" y2="305"/>
                <line x1="259.3" y1="270" x2="320" y2="305"/>
              </g>
              <ellipse cx="190" cy="330" rx="120" ry="14" fill="url(#k2-violet)" opacity="0.55"/>
            </svg>
            <div class="ov-card__veil"></div>
            <div class="ov-card__body">
              <h3 class="ov-card__title">Components</h3>
              <p class="ov-card__desc">Self-contained elements built from tokens: buttons, inputs, cards.</p>
              <span class="pos-button pos-button-primary ov-card__btn">
                Components
<span class="ov-card__btn-icon">{% render 'modules/common-styling/icon', icon: 'dashRight' %}</span>
              </span>
            </div>
          </a>

          <!-- ============================================================ -->
          <!-- CARD 3 — COMPOSITES                                           -->
          <!-- ============================================================ -->
          <a class="ov-card" href="#" tabindex="0" aria-label="Complex Components">
            <svg class="ov-card__bg" viewBox="-50 100 380 460" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
              <defs>
                <linearGradient id="k3-top-a" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.45"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.28"/>
                </linearGradient>
                <linearGradient id="k3-left-a" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.12"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.22"/>
                </linearGradient>
                <linearGradient id="k3-right-a" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.28"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.42"/>
                </linearGradient>
                <linearGradient id="k3-top-b" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.38"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.22"/>
                </linearGradient>
                <linearGradient id="k3-left-b" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.1"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.18"/>
                </linearGradient>
                <linearGradient id="k3-right-b" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.22"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.34"/>
                </linearGradient>
                <linearGradient id="k3-top-c" x1="0" y1="0" x2="0.5" y2="1">
                  <stop offset="0%" stop-color="#ffffff" stop-opacity="0.32"/>
                  <stop offset="100%" stop-color="#ffffff" stop-opacity="0.18"/>
                </linearGradient>
                <linearGradient id="k3-left-c" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.08"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.15"/>
                </linearGradient>
                <linearGradient id="k3-right-c" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#000000" stop-opacity="0.18"/>
                  <stop offset="100%" stop-color="#000000" stop-opacity="0.28"/>
                </linearGradient>
                <radialGradient id="k3-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="currentColor" stop-opacity="0.2"/>
                  <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                </radialGradient>
              </defs>
              <rect width="380" height="460" fill="none"/>
              <circle class="ov-glow" cx="190" cy="230" r="200" fill="url(#k3-glow)"/>
              <g class="ov-cube ov-cube-a">
                <polygon points="190,140 250.6,175 190,210" fill="url(#k3-top-a)"/>
                <polygon points="190,140 129.4,175 190,210" fill="url(#k3-top-a)" opacity="0.88"/>
                <polygon points="129.4,175 190,210 190,280 129.4,245" fill="url(#k3-left-a)"/>
                <polygon points="250.6,175 190,210 190,280 250.6,245" fill="url(#k3-right-a)"/>
                <line x1="190" y1="210" x2="190" y2="280" stroke="rgba(255,255,255,0.18)" stroke-width="0.6"/>
                <line x1="129.4" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
                <line x1="250.6" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
              </g>
              <g class="ov-cube ov-cube-b">
                <polygon points="190,140 250.6,175 190,210" fill="url(#k3-top-b)"/>
                <polygon points="190,140 129.4,175 190,210" fill="url(#k3-top-b)" opacity="0.88"/>
                <polygon points="129.4,175 190,210 190,280 129.4,245" fill="url(#k3-left-b)"/>
                <polygon points="250.6,175 190,210 190,280 250.6,245" fill="url(#k3-right-b)"/>
                <line x1="190" y1="210" x2="190" y2="280" stroke="rgba(255,255,255,0.18)" stroke-width="0.6"/>
                <line x1="129.4" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
                <line x1="250.6" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
              </g>
              <g class="ov-cube ov-cube-c">
                <polygon points="190,140 250.6,175 190,210" fill="url(#k3-top-c)"/>
                <polygon points="190,140 129.4,175 190,210" fill="url(#k3-top-c)" opacity="0.88"/>
                <polygon points="129.4,175 190,210 190,280 129.4,245" fill="url(#k3-left-c)"/>
                <polygon points="250.6,175 190,210 190,280 250.6,245" fill="url(#k3-right-c)"/>
                <line x1="190" y1="210" x2="190" y2="280" stroke="rgba(255,255,255,0.18)" stroke-width="0.6"/>
                <line x1="129.4" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
                <line x1="250.6" y1="175" x2="190" y2="280" stroke="rgba(255,255,255,0.12)" stroke-width="0.6"/>
              </g>
            </svg>
            <div class="ov-card__veil"></div>
            <div class="ov-card__body">
              <h3 class="ov-card__title">Complex Components</h3>
              <p class="ov-card__desc">Multiple components connected at their edges into a system-level pattern.</p>
              <span class="pos-button pos-button-primary ov-card__btn">
                Complex Components
<span class="ov-card__btn-icon">{% render 'modules/common-styling/icon', icon: 'dashRight' %}</span>
              </span>
            </div>
          </a>

        </div>

        <!-- ── COMPONENT CARDS ──────────────────────────────────── -->

        <!-- Uncategorized -->
        <div class="ov-comp-grid">

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-avatar" style="position:relative">
            <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'user' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Avatar</span></h3>
              <p class="pos-feature-card-text">User identity display with initials fallback and image support, in seven sizes.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-badge">
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'sticker' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Badge</span></h3>
              <p class="pos-feature-card-text">A dot or a small count on an icon, avatar or tab — new items, unread messages.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-slider">
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'adjustments-horizontal' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Slider</span></h3>
              <p class="pos-feature-card-text">Pick a value from a range by dragging a handle; the value shows above it while dragging.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-tag" style="position:relative">
            <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'tag' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Tag</span></h3>
              <p class="pos-feature-card-text">Non-interactive label used to categorize or describe content.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-chip">
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'label' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Chip</span></h3>
              <p class="pos-feature-card-text">Compact status label, often used in tables and lists.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-code">
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'file-code-2' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Code</span></h3>
              <p class="pos-feature-card-text">Inline or block display of code snippets in monospace style.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-dropdown-button">
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'plus' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Dropdown button</span></h3>
              <p class="pos-feature-card-text">A primary button that opens a short list of related actions right below it.</p>
            </div>
          </a>

          <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-link" style="position:relative">
            <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
            <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'hyperlink-2' %}</div>
            <div class="pos-feature-card-body">
              <h3 class="pos-feature-card-title"><span>Link</span></h3>
              <p class="pos-feature-card-text">Inline text element that navigates to another page or section.</p>
            </div>
          </a>

        </div>

        <!-- Buttons -->
        <div class="ov-comp-section">
          <h3 class="ov-comp-section-label">Buttons</h3>
          <div class="ov-comp-grid">

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-button" style="position:relative">
              <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'touchpad-finger' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Button</span></h3>
                <p class="pos-feature-card-text">A clickable element that lets users take action.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-control-icons">
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'arrow-down-1' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Control icons</span></h3>
                <p class="pos-feature-card-text">Close and expand/collapse icons for dismissing or toggling UI elements.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-tile-btn">
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'layout-grid-add' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Choice button</span></h3>
                <p class="pos-feature-card-text">Icon-and-label toggle button, used in grouped selections.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-toggle-btn">
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'toggle-right' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Toggle button</span></h3>
                <p class="pos-feature-card-text">A standalone on/off switch, with no label or card wrapper.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-segmented">
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'circuit-switch-closed' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Segmented button</span></h3>
                <p class="pos-feature-card-text">Horizontal group of mutually exclusive options with a sliding indicator.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-switch-card">
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'device-nintendo-rotated' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Switch button</span></h3>
                <p class="pos-feature-card-text">A toggle card that combines a switch with a label, used for enabling or disabling a setting.</p>
              </div>
            </a>

          </div>
        </div>

        <!-- Form elements -->
        <div class="ov-comp-section">
          <h3 class="ov-comp-section-label">Form elements</h3>
          <div class="ov-comp-grid">

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-checkbox" style="position:relative">
              <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'check-square' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Checkbox</span></h3>
                <p class="pos-feature-card-text">Multi-selection input that lets users toggle one or more independent options.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-radio" style="position:relative">
              <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'circle-dot' %}</div>
              <div class="pos-feature-card-body">
                <h3 class="pos-feature-card-title"><span>Radio</span></h3>
                <p class="pos-feature-card-text">Single-selection input from a group of mutually exclusive options.</p>
              </div>
            </a>

            <a class="pos-feature-card pos-feature-card--small" href="/style-guide/component-template#comp-section-multiselect" style="position:relative">
              <span class="pos-tag pos-tag--small" style="position:absolute;top:.5rem;right:.5rem">Legacy</span>
              <div class="pos-feature-card-icon">{% render 'modules/common-styling/icon', icon: 'edit-bulk' %}</div>
              <div class="pos-feature-card-body">

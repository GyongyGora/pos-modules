  var RADIUS = {
    'sharp': 'var(--pos-primitive-radius-sharp)',
    'slightly-rounded': 'var(--pos-primitive-radius-slightly-rounded)',
    'mid-rounded': 'var(--pos-primitive-radius-mid-rounded)',
    'rounded': 'var(--pos-primitive-radius-rounded)',
    'pill': 'var(--pos-primitive-radius-pill)'
  };
  function radiusValue(key) { return RADIUS[key] || ''; }
  document.getElementById('themes-radius-button').addEventListener('change', function () {
    var v = radiusValue(this.value);
    setOverride('--pos-radius-button', v);
    setOverride('--pos-radius-button-focus', v ? 'calc(' + v + ' + 2px)' : '');
  });
  document.getElementById('themes-radius-input').addEventListener('change', function () {
    setOverride('--pos-radius-input', radiusValue(this.value));
  });

})();
</script>


                    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-pw-strength-btn="1">Weak</button>
                    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-pw-strength-btn="2">Medium</button>
                    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-pw-strength-btn="3">Strong</button>
                  </div>
                </div>
              </div>

            </div><!-- /#comp-tab-variants -->


            <!-- USAGE TAB ─────────────────────────────────────────── -->
            <div class="comp-right-tab-panel"
                 id="comp-tab-usage"
                 role="tabpanel"
                 aria-labelledby="comp-tab-btn-usage"
                 hidden>

              <div class="comp-right-usage" id="comp-right-usage">
                <!-- populated by JS on component switch -->
              </div>

            </div><!-- /#comp-tab-usage -->

          </div><!-- /.comp-right-panels -->

        </div><!-- /.comp-doc-right-main -->


        <!-- Code side panel removed 2026-08-26 — reverted, see component-template.liquid's Button
             section for the replacement (a small fixed code block under the preview). -->


        <!-- ── TOKENS SIDE PANEL (second column, opens alongside main) -->
        <div class="comp-tokens-panel" id="comp-tokens-panel">

          <div class="comp-tokens-panel-header">
            <select class="t-name-select" id="comp-tokens-format" aria-label="Token name format">
              <option value="figma">Figma (variables)</option>
              <option value="css">CSS</option>
            </select>
            <button type="button" class="pos-close" id="comp-tokens-close" aria-label="Close token panel" style="font-size: var(--pos-size-icon-xs);">
              {% render 'modules/common-styling/icon', icon: 'x' %}
            </button>
          </div>

          <div class="comp-tokens-panel-intro">
            <div class="comp-tokens-panel-intro-title">
              {% render 'modules/common-styling/icon', icon: 'layers-1' %}
              Tokens
            </div>
          </div>

          <div class="comp-tokens-panel-body" id="comp-tokens-panel-body">
            <!-- populated by JS — see COMPONENT_TOKENS data structure below -->
          </div><!-- /.comp-tokens-panel-body -->

        </div><!-- /.comp-tokens-panel -->

      </aside><!-- /.comp-doc-right -->

    </div><!-- /.comp-doc-body -->

  </div><!-- /.styleguide-ds-layout -->

</div><!-- /.styleguide-ds -->



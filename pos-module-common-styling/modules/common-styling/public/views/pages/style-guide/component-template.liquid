                      </svg>
                    </span>
                    <span class="pos-tile-btn-label">Disabled</span>
                  </button>

                </div>
              </div>

              <!-- Password options -->
              <div class="comp-right-control-section" data-comp-control="password-options" id="comp-password-options">
                <h3 class="comp-right-control-label">Options</h3>
                <label class="pos-switch-card pos-switch-card--small">
                  <input type="checkbox" role="switch" class="pos-switch-card-input" id="comp-pw-opt-meter" data-pw-option="meter">
                  <span class="pos-switch-card-label">Meter</span>
                  <span class="pos-switch-card-toggle" aria-hidden="true"></span>
                </label>

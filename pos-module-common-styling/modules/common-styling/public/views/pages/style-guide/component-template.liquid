                        <path d="M16 20h2a2 2 0 0 0 2 -2v-2" />
                      </svg>
                    </span>
                    <span class="pos-tile-btn-label">Focus</span>
                  </button>

                  <button type="button" class="pos-tile-btn" aria-pressed="false" data-password-state-btn="active">

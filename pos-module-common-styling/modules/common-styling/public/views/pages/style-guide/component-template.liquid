<script>
  /* Inline (not the external styleguide-component-page.js) so this can never be affected by
     that file's own load/MIME-type status — this must run no matter what. When the URL already
     has a #comp-section-* hash on load, the browser's native "scroll the target into view"
     behavior moves <html>'s scroll position (confirmed via reproduction: CSS overflow:hidden
     and overflow-anchor:none on <html> do NOT prevent this — it isn't scroll anchoring, it's
     the browser's built-in fragment-navigation scroll, which only a script can override). That
     shifts this fixed-height (100dvh) layout up, taking the right sidebar's tabs off-screen.
     The app's own scroll-sync exclusively targets #main-content, so the outer scroll
     (window/html/body) is never legitimate here — just keep forcing it back to 0. */
  (function () {
    function resetOuterScroll() {
      if (window.scrollY !== 0) window.scrollTo(0, 0);
      if (document.documentElement.scrollTop !== 0) document.documentElement.scrollTop = 0;
      if (document.body && document.body.scrollTop !== 0) document.body.scrollTop = 0;
    }
    resetOuterScroll();
    document.addEventListener('DOMContentLoaded', resetOuterScroll);
    window.addEventListener('load', resetOuterScroll);
    window.addEventListener('scroll', resetOuterScroll, { passive: true });
    document.addEventListener('scroll', resetOuterScroll, { capture: true, passive: true });
    setTimeout(function () {
      window.removeEventListener('scroll', resetOuterScroll, { passive: true });
      document.removeEventListener('scroll', resetOuterScroll, { capture: true, passive: true });
    }, 6000);
  })();
</script>

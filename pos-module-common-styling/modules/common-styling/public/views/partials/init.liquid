<script>
  if(typeof window.pos !== 'object'){
    window.pos = {};
    window.pos.modules = {};
    window.pos.modules.active = {};
    window.pos.behaviors = {};
    window.pos.translations = {};
    window.pos.debug = false;
    window.pos.csrfToken = '{{ context.authenticity_token }}';
  }

  /* disabled click guard (RULES.md 4.12): disabled elements keep their pointer events so they can
     show the not-allowed cursor, so a click on an aria-disabled element (or anything inside it) and
     on a .pos-link--disabled link is stopped here, before any other handler runs — native
     [disabled] controls are already inert. Registered once, even if the partial renders twice. */
  if(!window.pos.disabledClickGuard){
    window.pos.disabledClickGuard = true;
    ['click', 'auxclick'].forEach(type => {
      document.addEventListener(type, event => {
        if(event.target instanceof Element && event.target.closest('[aria-disabled="true"], .pos-link--disabled')){
          event.preventDefault();
          event.stopImmediatePropagation();
        }
      }, true);
    });
  }
</script>
<script src="{{ 'modules/common-styling/js/pos-debug.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-keyboard-nav.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-behavior-sliding-indicator.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-behavior-resize.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-behavior-smooth-scroll.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-behavior-expand-collapse.js' | asset_url }}" defer></script>
<script src="{{ 'modules/common-styling/js/pos-behavior-dismiss.js' | asset_url }}" defer></script>

<script>
  /* selectively load interactive modules */
  document.addEventListener('DOMContentLoaded', () => {

    /* multiselect input */
    if (document.querySelector('.pos-form-multiselect')) {
      import('{{ 'modules/common-styling/js/pos-forms-multiselect.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-form-multiselect').forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-multiselect-${index}`] = new window.pos.modules.multiselect(element, {});
        });
      });
    }

    /* slider: fill and value tooltip follow the range input */
    if (document.querySelector('.pos-slider-field')) {
      import('{{ 'modules/common-styling/js/pos-slider.js' | asset_url }}').then(() => {
        document.querySelectorAll('.pos-slider-field').forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-slider-${index}`] = new window.pos.modules.slider(element);
        });
      });
    }

    /* number selector: stepper buttons, limits, filled state (keyed by the input's id) */
    if (document.querySelector('.pos-number-selector')) {
      import('{{ 'modules/common-styling/js/pos-number-selector.js' | asset_url }}').then(() => {
        document.querySelectorAll('.pos-number-selector').forEach((element, index) => {
          const input = element.querySelector('.pos-number-selector-input');
          window.pos.modules.active[(input && input.id) || `pos-number-selector-${index}`] = new window.pos.modules.numberSelector(element);
        });
      });
    }

    /* password input */
    if (document.querySelector('.pos-form-password')) {
      import('{{ 'modules/common-styling/js/pos-forms-password.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-form-password').forEach((element, index) => {
          window.pos.modules.active[element.querySelector('input').id || `pos-password-${index}`] = new window.pos.modules.password(element, { password: element.value });
        });
      });
    }

    /* file upload: Uppy is loaded only when the page has an upload field */
    if (document.querySelector('.pos-upload')) {
      import('{{ 'modules/common-styling/js/dependency-uppy.js' | asset_url }}').then(module => {
        window.pos.modules.uppy = module;

        import('{{ 'modules/common-styling/js/pos-upload.js' | asset_url }}').then(module => {
          document.querySelectorAll('.pos-upload').forEach((element, index) => {
            window.pos.modules.active[element.id || `pos-upload-${index}`] = new window.pos.modules.upload({
              container: element,
              imageEditorEnabled: element.dataset.imageEditorEnabled === 'true',
              allowedFileTypes: element.dataset.allowedFileTypes,
              aspectRatio: element.dataset.aspectRatio,
              maxNumberOfFiles: element.dataset.maxNumberOfFiles,
              maxFileSize: element.dataset.maxFileSize,
              width: element.dataset.width,
              height: element.dataset.height
            });
          });
        });
      });
    }

    /* markdown editor: EasyMDE is loaded only when the page has a markdown field.
       dependency-easyMde.js sets the EasyMDE global as a side effect (not an ES export). */
    if (document.querySelector('.pos-markdown')) {
      import('{{ 'modules/common-styling/js/dependency-easyMde.js' | asset_url }}').then(() => {
        import('{{ 'modules/common-styling/js/pos-markdown.js' | asset_url }}').then(module => {
          document.querySelectorAll('.pos-markdown').forEach((element, index) => {
            window.pos.modules.active[element.id || `pos-markdown-${index}`] = new window.pos.modules.markdown({
              container: element,
              id: element.id || `pos-markdown-${index}`,
              minlength: element.dataset.minlength,
              maxlength: element.dataset.maxlength
            });
          });
        });
      });
    }


{%- if auto_init_components != false %}
    /* dialogs, popovers, collapsible lists, code highlighting and data-load-content.
       Pages that create these instances themselves (the docs site) render this partial
       with auto_init_components: false. */

    /* popovers (and dropdown buttons — same keyboard and focus handling) */
    if (document.querySelector('.pos-popover, .pos-dropdown-button')) {
      import('{{ 'modules/common-styling/js/pos-popover.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-popover, .pos-dropdown-button').forEach((element) => {
          var popoverEl = element.querySelector('[popover]');
          if (!popoverEl) return;
          window.pos.modules.active[popoverEl.id] = new window.pos.modules.popover(element);
        });
      });
    }

    /* dialogs */
    if (document.querySelector('[data-dialogtarget]')) {
      import('{{ 'modules/common-styling/js/pos-dialog.js' | asset_url }}').then(module => {
        document.querySelectorAll('[data-dialogtarget]').forEach((element) => {
          window.pos.modules.active[element.dataset.dialogtarget] = new window.pos.modules.dialog({
            trigger: element,
            container: document.querySelector('#' + element.dataset.dialogtarget)
          });
        });
      });
    }

    /* collapsible lists */
    if (document.querySelector('.pos-collapsible')) {
      import('{{ 'modules/common-styling/js/pos-collapsible.js' | asset_url }}').then(module => {
        document.querySelectorAll('.pos-collapsible').forEach((element, index) => {
          window.pos.modules.active[element.id || `pos-collapsible-${index}`] = new window.pos.modules.collapsible({
            container: element,
            id: element.id || `pos-collapsible-${index}`
          });
        });
      });
    }

    /* code highlighting */
    if (document.querySelector('pre code')) {
      import('{{ 'modules/common-styling/js/dependency-highlightJs.js' | asset_url }}').then(() => {
        import('{{ 'modules/common-styling/js/pos-code.js' | asset_url }}').then(module => {
          document.querySelectorAll('pre code').forEach((element, index) => {
            window.pos.modules.active[`pos-code-${index}`] = new window.pos.modules.code({
              container: element,
              id: `pos-code-${index}`
            });
          });
        });
      });
    }

    /* load HTML from an endpoint into a container — data-load-content / -target / -where /
       -trigger-type / -paginated (see js/pos-load.js) */
    if (document.querySelector('[data-load-content]')) {
      import('{{ 'modules/common-styling/js/pos-load.js' | asset_url }}').then(module => {
        document.querySelectorAll('[data-load-content]').forEach((load, i) => {
          const id = load.id ? load.id : 'load-' + load.getAttribute('data-load-target') + '-' + i;
          window.pos.modules.active[id] = new window.pos.modules.load({
            id: id,
            endpoint: load.getAttribute('data-load-content'),
            target: load.getAttribute('data-load-target'),
            where: load.getAttribute('data-load-where'),
            trigger: load,
            triggerType: load.getAttribute('data-load-trigger-type') || 'click',
            paginated: load.getAttribute('data-load-paginated') === 'true'
          });
        });
      });
    }
{%- endif %}

  });
</script>


<div class="styleguide-ds-nav-search">
  <label class="pos-label" for="styleguide-nav-search">Search</label>
  <div class="styleguide-nav-search-wrapper">
    <span class="styleguide-nav-search-icon" aria-hidden="true">{% render 'modules/common-styling/icon', icon: 'search' %}</span>
    <input type="search" id="styleguide-nav-search" class="pos-form-input" placeholder="Find components…" autocomplete="off">
    <button type="button" class="styleguide-nav-search-clear" id="styleguide-nav-search-clear" aria-label="Clear search">{% render 'modules/common-styling/icon', icon: 'x' %}</button>
  </div>
</div>

<ul class="pos-collapsible">
  {% for section in nav_items %}
    {% liquid
      assign active_child = section.children | array_detect: url: active
      unless active_child
        for child in section.children
          assign child_base = child.url | split: '#' | first
          if child_base == active
            assign active_child = child
            break
          endif
          assign active_child = child.children | array_detect: url: active
          if active_child
            break
          endif
        endfor
      endunless
    %}
    <li>
      <span class="styleguide-ds-nav-section-label">
        {% if section.icon %}
          {% render 'modules/common-styling/icon', icon: section.icon %}
        {% endif %}
        {{ section.label }}
      </span>
      <button type="button" class="pos-collapsible-toggle" aria-expanded="false" aria-controls="pos-collapsible-{{ section.label | slugify }}">
        {% render 'modules/common-styling/icon', icon: 'dashRight' %}
        <span class="pos-label">Expand "{{ section.label }}"</span>
      </button>
      <div id="pos-collapsible-{{ section.label | slugify }}" class="pos-collapsible-children"{% unless active_child %} inert{% endunless %}>
        {% render 'modules/common-styling/navigation/collapsible', items: section.children, inert: true, active: active %}
      </div>
    </li>
  {% endfor %}
</ul>

<div class="styleguide-ds-theme-toggle-wrapper">
  <div class="pos-segmented-control pos-segmented-control--subtle pos-segmented-control--small" role="group" aria-label="Color scheme" id="styleguide-theme-toggle">
    <button type="button" class="pos-segmented-control-btn pos-segmented-control-btn--active" aria-pressed="true" data-theme="light" aria-label="Light mode">
      {% render 'modules/common-styling/icon', icon: 'brightness' %}
    </button>
    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-theme="dark" aria-label="Dark mode">
      {% render 'modules/common-styling/icon', icon: 'moon' %}
    </button>
    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-theme="a11y" aria-label="High contrast mode">
      {% render 'modules/common-styling/icon', icon: 'contrast' %}
    </button>
  </div>

  <div class="pos-segmented-control pos-segmented-control--subtle pos-segmented-control--small" role="group" aria-label="Text size" id="styleguide-font-toggle">
    <button type="button" class="pos-segmented-control-btn pos-segmented-control-btn--active" aria-pressed="true" data-font="default" aria-label="Default text size">A</button>
    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-font="large" aria-label="Large text size" style="font-size:1.1em">A</button>
    <button type="button" class="pos-segmented-control-btn" aria-pressed="false" data-font="xl" aria-label="Extra large text size" style="font-size:1.25em">A</button>
  </div>
</div>


<script>
  (function() {
    var themeToggle = document.getElementById('styleguide-theme-toggle');
    var html = document.documentElement;

    function applyTheme(theme) {
      html.classList.remove('pos-theme-darkEnabled', 'pos-theme-dark', 'pos-theme-a11yEnabled', 'pos-theme-a11y');
      if (theme === 'dark') {
        html.classList.add('pos-theme-darkEnabled', 'pos-theme-dark');
      } else if (theme === 'a11y') {
        html.classList.add('pos-theme-a11yEnabled', 'pos-theme-a11y');
      }
      themeToggle.querySelectorAll('.pos-segmented-control-btn').forEach(function(b) {
        var active = b.dataset.theme === theme;
        b.classList.toggle('pos-segmented-control-btn--active', active);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
    }

    var saved = localStorage.getItem('styleguide-theme');
    if (saved === 'dark' || saved === 'a11y') applyTheme(saved);

    themeToggle.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-theme]');
      if (!btn) return;
      var theme = btn.dataset.theme;
      applyTheme(theme);
      localStorage.setItem('styleguide-theme', theme);
    });
  })();

  // font size toggle
  (function() {
    var fontToggle = document.getElementById('styleguide-font-toggle');
    var html = document.documentElement;
    var sizes = { default: '100%', large: '112.5%', xl: '125%' };

    function applyFont(size) {
      html.style.fontSize = sizes[size] || '100%';
      requestAnimationFrame(function() { window.dispatchEvent(new Event('resize')); });
      fontToggle.querySelectorAll('.pos-segmented-control-btn').forEach(function(b) {
        var active = b.dataset.font === size;
        b.classList.toggle('pos-segmented-control-btn--active', active);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      // sync right sidebar a11y toggle if present
      var a11yToggle = document.getElementById('comp-a11y-text-size');
      if (a11yToggle) a11yToggle.checked = (size === 'xl');
    }

    var savedFont = localStorage.getItem('styleguide-font');
    if (savedFont && sizes[savedFont]) applyFont(savedFont);

    fontToggle.addEventListener('click', function(e) {
      var btn = e.target.closest('[data-font]');
      if (!btn) return;
      var size = btn.dataset.font;
      applyFont(size);
      localStorage.setItem('styleguide-font', size);
    });
  })();

  // accordion: only one top-level section open at a time
  (function() {
    var topNav = document.querySelector('.styleguide-ds-sidebar .pos-collapsible');
    if (!topNav) return;
    topNav.addEventListener('click', function(e) {
      var btn = e.target.closest('.pos-collapsible-toggle');
      if (!btn || btn.closest('li').parentElement !== topNav) return;
      requestAnimationFrame(function() {
        if (btn.getAttribute('aria-expanded') !== 'true') return;
        Array.from(topNav.children).forEach(function(li) {
          var other = li.querySelector('.pos-collapsible-toggle');
          if (other && other !== btn && other.getAttribute('aria-expanded') === 'true') {
            other.click();
          }
        });
      });
    });
  })();

  // nav search filter + clear button
  (function() {
    var input = document.getElementById('styleguide-nav-search');
    var clearBtn = document.getElementById('styleguide-nav-search-clear');
    var nav = input.closest('.styleguide-ds-sidebar').querySelector('.pos-collapsible');

    function getLinkText(anchor) {
      // collect only text nodes (skip badge chip spans)
      var text = '';
      anchor.childNodes.forEach(function(node) {
        if (node.nodeType === 3) text += node.textContent;
      });
      return text.trim().toLowerCase();
    }

    function filterNav(q) {
      // Pass 1: show/hide individual nav link <li> (those with a direct <a> child)
      nav.querySelectorAll('li:has(> a)').forEach(function(li) {
        var text = getLinkText(li.querySelector('a'));
        li.style.display = (!q || text.includes(q)) ? '' : 'none';
      });

      // Pass 2: show/hide section header <li> based on whether any child link is visible
      nav.querySelectorAll('li:not(:has(> a))').forEach(function(sectionLi) {
        var childrenDiv = sectionLi.querySelector('.pos-collapsible-children');
        var anyVisible = Array.from(sectionLi.querySelectorAll('li:has(> a)')).some(function(li) {
          return li.style.display !== 'none';
        });
        sectionLi.style.display = (!q || anyVisible) ? '' : 'none';
        if (q && anyVisible && childrenDiv) childrenDiv.removeAttribute('inert');
      });
    }

    function updateClear() {
      var active = input.value || document.activeElement === input;
      clearBtn.style.opacity = active ? '1' : '0';
      clearBtn.style.pointerEvents = active ? 'auto' : 'none';
    }

    input.addEventListener('input', function() {
      filterNav(input.value.trim().toLowerCase());
      updateClear();
    });

    input.addEventListener('focus', updateClear);
    input.addEventListener('blur', updateClear);

    clearBtn.addEventListener('click', function() {
      input.value = '';
      filterNav('');
      updateClear();
      input.focus();
    });

    updateClear();
  })();
</script>



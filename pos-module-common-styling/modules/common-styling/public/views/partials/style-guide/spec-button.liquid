{% raw %}
{
  "_about": "Component spec for pos-button (new DS docs/inspect refactor pilot). Single source of truth for the Variants/Usage/Code/Tokens tabs on /style-guide/button — replaces the old inspect-button.liquid + BUTTON_TOKENS (styleguide-component-page.js) dual-source setup. Generated 2026-08-25 by resolving the actual CSS cascade in pos-button.css (script-assisted, not hand-typed) plus a css-to-figma.json lookup for Figma names. Audience: the doc-site renderer (human layer) and any AI reading this file directly (AI-readable layer). Regenerate by re-running the resolver against pos-button.css if the CSS changes; do not hand-edit token values here without re-verifying against the CSS. 2026-09-04: found pos-button--icon-only (already used in real preview markup, e.g. Popover's menu trigger and the style-guide page's own header buttons) was only ever defined in style-guide/styleguide.css — the docs site's own CSS, not the shippable pos-button.css — so it did nothing for any real product built on this DS outside the docs site itself. Moved the rule into pos-button.css as a proper modifier and removed the docs-only duplicate.",
  "component": "button",
  "name": "Button",
  "description": "A clickable control that triggers an action — submitting a form, opening a dialog, confirming a choice, or starting a process that does not navigate away from the page.",
  "whenToUse": "Triggering an action — submitting a form, opening a dialog, confirming a choice, or initiating any process that does not navigate away from the page. Use <code>pos-button</code> whenever the outcome is an action, not a navigation.",
  "whenNotToUse": "Navigation to another page or URL — use a link (<code>&lt;a&gt;</code>) instead. Do not use a button purely to make text look interactive.",
  "do": "Use <code>type=\"submit\"</code> on form submission buttons and <code>type=\"button\"</code> on all others. Choose the intent variant (<code>primary</code>, <code>secondary</code>, <code>secondary-filled</code>) that matches the action's visual weight and importance on the page.",
  "dont": "Do not place more than one primary button per screen — it creates competing calls to action. Do not rely on the button label alone to communicate a destructive action; pair it with a confirmation step.",
  "composedOf": [],
  "props": [
    {
      "name": "base class",
      "type": "'pos-button-primary' | 'pos-button-secondary' | 'pos-button-ghost' | (none = secondary-filled)",
      "default": "none (secondary-filled)",
      "description": "Visual weight. secondary-filled (no class) is the default white/filled look; add pos-button-primary for the main call-to-action; add pos-button-secondary for the transparent-background outline look; add pos-button-ghost for icon+text only — same as secondary but with no visible frame at rest, revealing an interactive-grey frame (HC-visible) only on hover."
    },
    {
      "name": "intent class",
      "type": "'pos-button-error' | 'pos-button-success' | 'pos-button-inverted' | (none)",
      "default": "none",
      "description": "Mutually exclusive with each other — only one at a time. error/success overlay a destructive/confirming color scheme on top of the base class; inverted switches to the inverted color set for a dark/brand-colored surface. There is no combined error+inverted or success+inverted variant — pos-button.css has no rule for that combination and the doc-site UI's Intent control only ever applies one of these four at a time."
    },
    {
      "name": "pos-button-small",
      "type": "boolean class",
      "default": "false",
      "description": "Compact size — smaller height, padding, font-size and icon size."
    },
    {
      "name": "pos-button--icon-only",
      "type": "boolean class",
      "default": "false",
      "description": "Square button — no inline padding, centered icon, no text label. Requires an aria-label since there is no visible text. Combine with pos-button-small for the compact square size."
    },
    {
      "name": "pos-button--loading",
      "type": "boolean class",
      "default": "false",
      "description": "Blocks pointer interaction (pointer-events: none) while an async action is pending — no not-allowed cursor, loading is not a disabled state (RULES.md 4.12 exception). Combine with a .pos-spinner instance in .pos-button-loading-icon, or animated trailing dots via .pos-button-loading-text."
    },
    {
      "name": "disabled",
      "type": "boolean attribute",
      "default": "false",
      "description": "Native disabled attribute — switches to the disabled color set for the current base/intent combination."
    }
  ],
  "usageExample": "<button type=\"button\" class=\"pos-button pos-button-primary\">Save</button>",

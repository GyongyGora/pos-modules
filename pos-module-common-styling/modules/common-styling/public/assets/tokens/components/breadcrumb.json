  "usageExample": "<nav class=\"pos-breadcrumb\" aria-label=\"Breadcrumb\">\n  <div class=\"pos-popover pos-breadcrumb-collapsed-trigger\">\n    <button type=\"button\" popovertarget=\"breadcrumb-hidden-1\" class=\"pos-breadcrumb-back\" aria-label=\"Show parent pages\">\n      <!-- dashLeft icon -->\n    </button>\n    <menu popover id=\"breadcrumb-hidden-1\">\n      <li><a href=\"/category\">Category</a></li>\n    </menu>\n  </div>\n  <ol class=\"pos-breadcrumb-list\">\n    <li class=\"pos-breadcrumb-item\">\n      <a href=\"/category\" class=\"pos-link\">Category</a>\n      <span class=\"pos-breadcrumb-separator\" aria-hidden=\"true\"><!-- dashRight icon --></span>\n    </li>\n    <li class=\"pos-breadcrumb-item\">\n      <span class=\"pos-breadcrumb-current\" aria-current=\"page\">Current page</span>\n    </li>\n  </ol>\n</nav>"

{
  "_about": "Component spec for pos-select (docs/inspect refactor, component migration batch, 2026-08-26). Single source of truth for the Variants/Usage/Tokens tabs on /style-guide \"Select\" section. Reuses the already-curated usage prose from COMP_CONFIGS['select'].usage and token data from COMP_CONFIGS['select'].tokens (verified-accurate, currently-live data) restructured into the new schema. Single representative variant — this component's preview shows one instance (no Variant/Base toggle needed per the 2026-08-25/26 \"multiple sub-variants side by side\" rule). Regenerate the spec partial with the script in RULES.md 6.4 if the source data changes; do not hand-edit token values here. Updated 2026-08-27: added usageExample/props/composedOf (Target architecture point 1 fields that were left empty when this spec was first generated).",
  "component": "select",
  "name": "Select",
  "description": "The user must choose one option from a long list (5+) of predefined values.",
  "whenToUse": [
    "The user must choose one option from a long list (5+) of predefined values.",
    "Space is limited and a dropdown is more compact than radio buttons.",
    "Use <code>disabled</code> + a pre-selected value to create a <strong>display-only</strong> field that loads or presents data without being editable."
  ],
  "whenNotToUse": [
    "There are fewer than 5 options — use radio buttons instead.",
    "Multiple selections are needed — use a multiselect instead."
  ],
  "do": [
    "Always include an empty placeholder option (value=\"\") as the first option.",
    "Use <code>required</code> when the field must be filled before submission.",
    "Pair with <code>.pos-form-error</code> / <code>.pos-form-success</code> for validation feedback."
  ],
  "dont": [
    "Pre-select a real value on initial load — leave the placeholder option selected."
  ],
  "accessibility": [
    "Associate a <code>&lt;label&gt;</code> via matching <code>for</code> and <code>id</code>.",
    "Use <code>aria-invalid</code> and link error messages via <code>aria-describedby</code>."
  ],
  "composedOf": [],
  "props": [
    {
      "name": "required",
      "type": "boolean attribute",
      "default": "false",
      "description": "Marks the field as required — pairs with the visible asterisk token."
    },
    {
      "name": "disabled",
      "type": "boolean attribute",
      "default": "false",
      "description": "Native disabled attribute."
    }
  ],
  "dimensions": {
    "state": [
      "closed",
      "hover",
      "focus",
      "opened",
      "filled",
      "disabled"
    ]
  },

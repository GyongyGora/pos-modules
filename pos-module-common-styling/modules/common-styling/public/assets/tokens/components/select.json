  "usageExample": "<form class=\"pos-form pos-form-simple\" action=\"#\" novalidate>\n  <fieldset>\n    <label for=\"my-select\">\n      <strong>Category</strong>\n    </label>\n    <div class=\"pos-form-input-wrapper\">\n      <select id=\"my-select\" class=\"pos-form-select\" required>\n        <option value=\"\">Select option</option>\n        <option value=\"design\">Design</option>\n      </select>\n      <span class=\"pos-form-input-icon\" aria-hidden=\"true\"><!-- dashDown icon --></span>\n    </div>\n    <p class=\"pos-form-error\" hidden>Please select a category</p>\n    <p class=\"pos-form-success\" hidden>Category selected</p>\n  </fieldset>\n</form>"

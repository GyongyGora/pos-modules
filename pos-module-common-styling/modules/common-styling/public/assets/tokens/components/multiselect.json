  "usageExample": "<div class=\"pos-form-multiselect\" id=\"my-multiselect\">\n  <div class=\"pos-form-multiselect-input pos-form-input\"\n       aria-expanded=\"false\"\n       aria-controls=\"my-multiselect-list\"\n       tabindex=\"0\">\n    <span class=\"pos-form-multiselect-placeholder\">Select options</span>\n    <ul class=\"pos-form-multiselect-selected-list\"><!-- populated by JS --></ul>\n    <!-- dashDown icon -->\n  </div>\n  <div class=\"pos-form-multiselect-list-container\" id=\"my-multiselect-list\">\n    <ul class=\"pos-form-multiselect-list\">\n      <li>\n        <input type=\"checkbox\" name=\"options[]\" value=\"a\" id=\"opt-a\" class=\"pos-form-checkbox\">\n        <label for=\"opt-a\">Option A</label>\n      </li>\n    </ul>\n  </div>\n</div>"

{
  "_about": "Component spec for pos-dropdown-button (style/pos-dropdown-button.css) — created 2026-10-06 from the Figma Button's Type=Dropdown (node 16340:19960), as its own component (the Button component is unchanged; in Figma it stays a Button variant). Decisions (user, 2026-10-06): the whole button opens the list (not a split button); item hover = the primary button's hover background (Figma draws hover the same as normal); primary only. One variant; states normal / hover / focus / disabled come from the Button it is built on (composedOf button, its tokens are not repeated — RULES.md 7.12), active = open (Figma State=Active). The trigger is a real .pos-button.pos-button-primary with popovertarget; the menu is a native popover; init runs the Popover module on the wrapper for keyboard navigation. Figma names resolved through pos-config.css (RULES.md §6.4). Regenerate spec-dropdown-button.liquid after any change here — never hand-edit the .liquid partial.",
  "component": "dropdown-button",
  "name": "Dropdown button",
  "description": "A primary button with an icon that opens a short list of related actions right below it (e.g. \"Add new\" → Page / Folder / Upload). The whole button opens the list; built on the native popover, so keyboard and light-dismiss work like the Popover.",
  "whenToUse": [
    "One entry point for a few related actions of the same kind (e.g. several things the user can add).",
    "The page already has its primary action and the related choices would crowd the toolbar as separate buttons."
  ],
  "whenNotToUse": [
    "There is only one action — use a plain primary button.",
    "The options are settings or a value the user picks — use a select or a segmented control.",
    "The list is long or needs search — use a popover with a menu or a multiselect."
  ],
  "do": [
    "Keep the list short (2–6 items) and the item labels to one or two words.",
    "Use an icon that says what the actions have in common (e.g. plus for \"add\").",
    "Use links for items that navigate and buttons for items that act on the page."
  ],
  "dont": [
    "Put more than one dropdown button in the same toolbar — it hides the actions.",
    "Nest a second list inside an item."
  ],
  "accessibility": [
    "The trigger is a real <button> with popovertarget — Enter / Space open the list, Esc and clicking outside close it, focus moves to the first item when opened by keyboard.",
    "Arrow up / down, Home and End move between items (the Popover module, loaded by init).",
    "Give the trigger a visible label; the icon is decorative (aria-hidden)."
  ],
  "composedOf": [
    "button"
  ],
  "props": [
    {
      "name": "popovertarget / id",
      "type": "attributes",
      "default": "none",
      "description": "The trigger's popovertarget must match the menu's id."
    },
    {
      "name": "disabled",
      "type": "attribute on the trigger",
      "default": "false",
      "description": "Disables the trigger (the list can't open)."
    }
  ],
  "dimensions": {
    "state": [
      "normal",
      "hover",
      "focus",
      "active",
      "disabled"
    ]
  },

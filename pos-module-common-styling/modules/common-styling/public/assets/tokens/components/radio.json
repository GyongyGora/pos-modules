      "name": "disabled",
      "type": "boolean attribute",
      "default": "false",
      "description": "Native disabled attribute."
    },
    {
      "name": "checked",
      "type": "boolean attribute",
      "default": "false",
      "description": "Native checked attribute — selected state."
    }
  ],

  "usageExample": "<div class=\"pos-feature-card\">\n  <span class=\"pos-tag pos-feature-card-badge\">New</span>\n  <div class=\"pos-feature-card-icon\"><!-- icon --></div>\n  <div class=\"pos-feature-card-body\">\n    <h3 class=\"pos-feature-card-title\"><span>Card title</span></h3>\n    <p class=\"pos-feature-card-subtitle\">A short lead sentence.</p>\n    <p class=\"pos-feature-card-lead\">Additional body text.</p>\n    <p class=\"pos-feature-card-text\">Regular body text.</p>\n    <a class=\"pos-link pos-link--small\" href=\"#\"\n      target=\"_blank\" rel=\"noopener noreferrer\">\n      Read more\n      <!-- dashRight icon -->\n      <span class=\"pos-label\">(opens in new tab)</span>\n    </a>\n  </div>\n  <div class=\"pos-feature-card-actions\">\n    <button class=\"pos-button pos-button-primary\">Sign up</button>\n    <button class=\"pos-button pos-button-secondary\">Learn more</button>\n  </div>\n</div>",

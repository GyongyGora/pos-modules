  "usageExample": "<div class=\"pos-form-password\">\n  <div class=\"pos-form-password-input-container\">\n    <input type=\"password\" name=\"password\" id=\"password\"\n           class=\"pos-form-input\" placeholder=\"••••••••\">\n    <button type=\"button\" title=\"Show password\" class=\"pos-form-password-toggle\">\n      <span class=\"pos-label\">Show password</span>\n      <!-- eye icon (show) -->\n      <!-- eyeStriked icon (hide) -->\n    </button>\n  </div>\n  <div class=\"pos-form-password-strength-meter\">\n    <span></span><span></span><span></span>\n  </div>\n  <div class=\"pos-form-password-strength-description\" aria-live=\"polite\">\n    <span class=\"pos-form-password-strength-description-weak\">Weak</span>\n    <span class=\"pos-form-password-strength-description-medium\">Medium</span>\n    <span class=\"pos-form-password-strength-description-strong\">Strong</span>\n  </div>\n</div>"

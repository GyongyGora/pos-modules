        "state": [
          {
            "figma": "enabled",
            "css": "pos-tile-btn"
          },
          {
            "figma": "selected",
            "css": "pos-tile-btn pos-tile-btn--selected"
          },
          {
            "figma": "hover",
            "css": ":hover"
          },
          {
            "figma": "disabled",
            "css": "pos-tile-btn[disabled]"
          },
          {
            "figma": "selected disabled",
            "css": "pos-tile-btn pos-tile-btn--selected[disabled]"
          }
        ]
      },
      "detail": "components/tile-btn.json",
      "when": "Letting the user select from a small set of prominent, mutually exclusive options — mode pickers, filter palettes, settings panels — where each option has an icon and benefits from a larger touch target."
    },
    "toggle-btn": {
      "class": "pos-toggle-btn",
      "element": "label > input[type=checkbox][role=switch] + span",
      "detail": "components/toggle-btn.json",
      "when": "A single, standalone on/off setting inline with other content (e.g. next to a label you already control elsewhere, or inside a table cell)."
    },
    "toast": {
      "class": "pos-toast",
      "js": "new window.pos.modules.toast('error' | 'success' | 'info' | 'warning', message, { delay, autohide, icon, debug })",
      "events": [
        "pos-modules-toast-ready"
      ],
      "detail": "components/toast.json",
      "when": "Confirming the result of a user action (save, delete, submit) without interrupting their flow.",
      "render": "render 'modules/common-styling/toasts', params: flash (in the layout, once) — from JS: new pos.modules.toast('<severity>', '<message>')"
    },
    "upload": {
      "class": "pos-upload",
      "js": "Uppy-based",
      "detail": "components/file-upload.json",
      "specs": [
        "file-upload"
      ],
      "when": "Letting a user attach one or more files (images, documents) to a form, with drag-and-drop and a file browser fallback.",
      "render": "render 'modules/common-styling/forms/upload', id: text, name: text, presigned_upload: object, files: array (optional), allowed_file_types: [text] (optional)"
    },
    "markdown": {
      "class": "pos-markdown",
      "js": "EasyMDE-based",
      "events": [
        "pos-markdown-initialized",
        "pos-markdown-changed",
        "pos-markdown-reset",
        "pos-markdown-image-uploaded",
        "pos-markdown-validation-passed",
        "pos-markdown-validation-failed",
        "pos-markdown-textarea-updated"
      ],
      "detail": "components/markdown.json",
      "when": "Letting a user write long-form, formatted content (descriptions, articles, comments) using Markdown syntax with a visual toolbar.",
      "render": "render 'modules/common-styling/forms/markdown', id: text, name: text, presigned_upload: object, value: text (optional), minlength / maxlength: int (optional)"
    },
    "breadcrumb": {
      "class": "pos-breadcrumb",
      "element": "nav",
      "figma": null,
      "variants": [
        "expanded",
        "collapsed"
      ],
      "states": [
        "normal",
        "hover",
        "focus"
      ],
      "composedOf": [
        "popover"
      ],
      "js": "new pos.modules.breadcrumb({ container })",
      "detail": "components/breadcrumb.json",
      "when": "Showing the user's location within a nested page hierarchy (e.g. Category > Subcategory > Product)."
    },
    "alert-card": {
      "class": "pos-card pos-card-alert pos-card-alert-<type>",
      "element": "div",
      "render": "render 'modules/common-styling/content/alert', type: 'info' | 'success' | 'warning' | 'error', content: text, title: text (optional), icon: false (optional), buttons: html (optional)",
      "when": "Showing an inline informational, warning, error, or success message within page content — adjacent to a card or content block.",
      "constraints": {
        "prefer_render_partial": true
      },
      "detail": "components/alert-card.json"
    },
    "text-input": {
      "class": "pos-form-input",
      "element": "input",
      "wrapper": "pos-form pos-form-simple + label.pos-label",
      "states": {
        "error": "aria-invalid=\"true\" on the input + p.pos-form-error message",
        "success": "aria-invalid=\"false\" on the input + p.pos-form-success message"
      },
      "when": "Collecting a single line of free-form text — names, emails, search queries, URLs, dates.",
      "constraints": {
        "every_input_needs_label": true
      },
      "detail": "components/text-input.json"
    },
    "textarea": {
      "class": "pos-form-input",
      "element": "textarea",
      "wrapper": "pos-form pos-form-simple",
      "when": "Collecting multi-line free-form text — descriptions, notes, comments.",
      "constraints": {
        "every_input_needs_label": true
      },
      "detail": "components/textarea.json"
    },
    "select": {
      "class": "pos-form-select",
      "element": "select",
      "wrapper": "pos-form pos-form-simple pos-form-input-wrapper (+ pos-form-input-icon for the arrow)",
      "when": "The user must choose one option from a long list (5+) of predefined values.",
      "constraints": {
        "min_options_for_select": 5,
        "fewer_options": "radio"
      },
      "detail": "components/select.json"
    },
    "slider": {
      "class": "pos-slider-field + pos-slider",
      "element": "div > input[type=range]",
      "figma": null,
      "states": [
        "normal",
        "focus"
      ],
      "interactive": true,
      "status": "new",
      "css": "style/pos-slider.css",
      "js": "js/pos-slider.js (loaded by init when a .pos-slider-field is on the page)",
      "detail": "components/slider.json",
      "when": "Picking an approximate value from a continuous range by dragging (volume, opacity, a percentage); not for exact numbers or a few options.",
      "markup": "<div class=\"pos-slider-field\" style=\"--ratio:.42\"><span class=\"pos-slider-value\" aria-hidden=\"true\">42</span><input type=\"range\" class=\"pos-slider\" min=\"0\" max=\"100\" value=\"42\" aria-label=\"…\"></div>",
      "constraints": {
        "label": "required (label for / aria-label)",
        "min_width_px": 160
      }
    },
    "checkbox": {
      "class": "pos-form-checkbox",
      "element": "input[type=checkbox] + label",
      "wrapper": "pos-form-simple",
      "when": "Selecting zero or more independent options from a list.",
      "detail": "components/checkbox.json"
    },
    "radio": {
      "class": "pos-form-radio",
      "element": "input[type=radio] + label",
      "wrapper": "pos-form-simple",
      "when": "Selecting exactly one option from a set of mutually exclusive choices.",
      "constraints": {
        "same_name_per_group": true
      },
      "detail": "components/radio.json"
    },
    "password": {
      "class": "pos-form-password",
      "element": "div > input[type=password] + button.pos-form-password-toggle",
      "when": "Collecting a password, PIN, or any value the user should not see while typing.",
      "constraints": {
        "always_include_visibility_toggle": true,
        "toggle_aria_label_reflects_state": true
      },
      "detail": "components/password.json",
      "render": "render 'modules/common-styling/forms/password', name: text, id: text, value: text (optional), class: text (optional), meter: bool (optional)"
    },
    "multiselect": {
      "class": "pos-form-multiselect",
      "element": "div (JS-driven)",
      "when": "Letting users select multiple values from a defined list — tags, categories, filters, permissions.",
      "modifiers": [
        "pos-form-multiselect-multiline",
        "pos-form-multiselect-combine"
      ],
      "detail": "components/multiselect.json",
      "render": "render 'modules/common-styling/forms/multiselect', id: text, list: [{ value, label }], selected: [values] (optional), form: text, name: text, required: bool (optional), combine_selected: bool (optional)"
    },
    "tooltip": {
      "attribute": "data-tooltip",
      "element": "text type: any interactive element (no wrapper); icon-text type: .pos-tooltip-anchor around the control",
      "when": "Icon-only controls — every icon-only button/action always needs one (RULES.md 4.2), reusing its own aria-label text.",
      "constraints": {
        "required_on_icon_only_buttons": true,
        "text_mirrors_aria_label": true,
        "interactive_content": false
      },
      "css": [
        "tooltip"
      ],
      "detail": "components/tooltip.json",
      "classes": [
        "pos-tooltip-anchor",
        "pos-tooltip",
        "pos-tooltip-text"
      ],
      "types": {
        "text": "data-tooltip=\"Label\" on the control",
        "icon-text": "<span class=\"pos-tooltip-anchor\"><button aria-describedby=\"tip-id\">…</button><span class=\"pos-tooltip\" role=\"tooltip\" id=\"tip-id\"><svg class=\"pos-icon\">…</svg><span class=\"pos-tooltip-text\"><span>Line</span><strong>Bold line</strong></span></span></span>"
      }
    },
    "control-icons": {
      "classes": {
        "close": "pos-close",
        "chevron": "pos-chevron"
      },
      "element": "button",
      "when": "Close (dismiss) and chevron (expand / collapse) icon buttons — reuse these instead of building your own.",
      "constraints": {
        "needs_aria_label": true
      },
      "css": [
        "close",
        "chevron"
      ],
      "detail": "components/control-icons.json"
    },
    "spinner": {
      "class": "pos-spinner",
      "element": "svg",
      "when": "Loading indicator for an ongoing process (also used by the button loading state). Size via width / height on the svg.",
      "css": [
        "spinner"
      ],
      "props": [
        {
          "name": "size",
          "type": "width / height on the <svg>",
          "default": "1em (inside a button)",
          "description": "Standalone 1.5rem, small 1rem (pos-spinner.css). Inside a button the 1em default follows the label size."
        },
        {
          "name": "accessible name",
          "type": "role=\"status\" + visually hidden text, or aria-hidden=\"true\"",
          "default": "required",
          "description": "A standalone spinner announces the loading state; inside a button that already says it is loading, hide the svg from assistive tech."
        }
      ]
    }
  },
  "layout": {
    "page": {
      "body_class": "pos-app",
      "padding_token": "--pos-padding-page",
      "bg_token": "--pos-color-page-background"
    },
    "typography": {
      "heading_1": "pos-heading-1",
      "heading_2": "pos-heading-2",
      "heading_3": "pos-heading-3",
      "heading_4": "pos-heading-4",
      "color_prominent": "--pos-color-content-text-prominent",
      "color_default": "--pos-color-content-text",
      "color_secondary": "--pos-color-content-text-supplementary"
    },
    "spacing": {
      "h1_to_subtitle": "--pos-gap-title-content",
      "section_heading_to_content": "--pos-gap-section-title-content",
      "section_to_section": "--pos-gap-section-section",
      "card_to_card": "--pos-gap-card-card",
      "elements_within_card": "--pos-gap-card-elements",
      "paragraph_to_paragraph": "--pos-gap-text-text",
      "tag_to_tag": "--pos-gap-tag-tag"
    }
  },
  "rules": {
    "no_hardcoded_values": true,
    "no_primitive_tokens_in_components": true,
    "css_layer": "@layer common-styling { }",
    "class_prefix": "pos-",
    "js_namespace": "window.pos",
    "theming": "theme = token overrides only (light / dark / high contrast blocks in style/pos-config.css) — no structural changes; never use prefers-color-scheme in component CSS",
    "typography": {
      "line_height_pairing": "every font size token must be paired with its matching line-height token — Size/font M → Line-height/lineH M; if no exact match exists, use the proportionally closest line-height token",
      "heading_color": "--pos-color-content-text-prominent — never leave headings at default body text color"
    },
    "color": {
      "interactive_text_vs_graphic": "--pos-color-interactive-text (text) and --pos-color-interactive (icons / graphics) are separate tokens — WCAG text contrast requires 4.5:1 minimum (AA), graphic/icon contrast requires only 3:1; this allows interactive graphics to use a lighter color than interactive text while both remain WCAG compliant",
      "interactive_text_token": "--pos-color-interactive-text",
      "interactive_graphic_token": "--pos-color-interactive"
    }
  },

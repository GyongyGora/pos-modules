    "dropdown-button": {
      "class": "pos-dropdown-button + pos-dropdown-button-trigger (on pos-button pos-button-primary) + pos-dropdown-button-menu",
      "element": "div > button[popovertarget] + menu[popover] > li > a | button",
      "figma": "Buttons/Button — Type=Dropdown",
      "states": [
        "normal",
        "hover",
        "focus",
        "active",
        "disabled"
      ],
      "interactive": true,
      "status": "new",
      "css": "style/pos-dropdown-button.css",
      "js": "js/pos-popover.js (run on .pos-dropdown-button by init)",
      "detail": "components/dropdown-button.json",
      "when": "One primary entry point for a few related actions (e.g. Add new → Page / Folder); not for picking a value (select) or a single action (button).",
      "markup": "<div class=\"pos-dropdown-button\"><button type=\"button\" class=\"pos-button pos-button-primary pos-dropdown-button-trigger\" popovertarget=\"add-menu\"><span class=\"pos-dropdown-button-icon\" aria-hidden=\"true\"><svg class=\"pos-icon\">…</svg></span>Add new</button><menu class=\"pos-dropdown-button-menu\" id=\"add-menu\" popover><li><a href=\"…\">Page</a></li><li><button type=\"button\">Folder</button></li></menu></div>",
      "constraints": {
        "items": "2–6",
        "variants": "primary only",
        "nested_menus": false,
        "popovertarget_matches_menu_id": true
      },
      "composedOf": [
        "button"
      ]
    },

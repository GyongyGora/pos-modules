  "dependencies": {
    "@uppy/aws-s3": "^5.1.0",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.0",
    "@uppy/drag-drop": "^5.1.0",
    "@uppy/image-editor": "^4.1.0",
    "@uppy/webcam": "^5.1.0"
  },
